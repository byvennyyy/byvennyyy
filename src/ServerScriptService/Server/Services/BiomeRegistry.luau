--!strict
--[[
	BiomeRegistry
	Owns the runtime view of every biome: its folder in Workspace.Obby (generated by StageBuilder when
	missing), the PathData built from Path/WP_nnnn, the ten checkpoint parts and their positions along
	the path, the egg pedestal CFrame, and the compact ClientBiomeInfo sent to players. Also the
	stage <-> biome arithmetic used by every other service.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Biomes = require(Shared.Config.Biomes)
local GameConfig = require(Shared.Config.GameConfig)
local PathUtil = require(Shared.PathUtil)
local Types = require(Shared.Types)
local StageBuilder = require(script.Parent.StageBuilder)

export type BiomeRuntime = {
	def: Types.BiomeDef,
	folder: Folder,
	path: Types.PathData,
	checkpoints: { BasePart },
	checkpointS: { number },
	eggPedestal: CFrame,
	exit: BasePart?, -- BiomeExit landing or the Finish part
}

local BiomeRegistry = {}

local runtimes: { [number]: BiomeRuntime } = {}
local clientInfoCache: { [number]: Types.ClientBiomeInfo } = {}
local finishPart: BasePart? = nil

local function obbyFolder(): Folder
	local existing = workspace:FindFirstChild("Obby")
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "Obby"
	folder.Parent = workspace
	return folder
end

local function readPath(biomeFolder: Folder): Types.PathData
	local pathFolder = biomeFolder:FindFirstChild("Path")
	assert(pathFolder, `{biomeFolder.Name} has no Path folder`)
	local parts: { BasePart } = {}
	for _, child in pathFolder:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(parts, child)
		end
	end
	table.sort(parts, function(a, b)
		return a.Name < b.Name
	end)
	assert(#parts >= 2, `{biomeFolder.Name}.Path needs at least 2 waypoints`)
	local points = table.create(#parts)
	for i, part in parts do
		points[i] = part.Position
	end
	return PathUtil.build(points)
end

local function readCheckpoints(biomeFolder: Folder): { BasePart }
	local checkpoints: { BasePart } = {}
	for stage = 1, GameConfig.StagesPerBiome do
		local stageFolder = biomeFolder:FindFirstChild(string.format("Stage_%02d", stage))
		assert(stageFolder, `{biomeFolder.Name} is missing Stage_{string.format("%02d", stage)}`)
		local checkpoint = stageFolder:FindFirstChild("Checkpoint")
		assert(
			checkpoint and checkpoint:IsA("BasePart"),
			`{biomeFolder.Name}.{stageFolder.Name} has no Checkpoint part`
		)
		checkpoints[stage] = checkpoint
	end
	return checkpoints
end

local function register(def: Types.BiomeDef, biomeFolder: Folder)
	local path = readPath(biomeFolder)
	local checkpoints = readCheckpoints(biomeFolder)
	local checkpointS = table.create(#checkpoints)
	for i, part in checkpoints do
		checkpointS[i] = PathUtil.project(path, part.Position)
		part:SetAttribute("Stage", (def.index - 1) * GameConfig.StagesPerBiome + i)
	end
	local pedestal = biomeFolder:FindFirstChild("EggPedestal")
	local pedestalCFrame = if pedestal and pedestal:IsA("BasePart")
		then pedestal.CFrame
		else checkpoints[1].CFrame * CFrame.new(0, 0, 12)
	local exit = biomeFolder:FindFirstChild("Finish") or biomeFolder:FindFirstChild("BiomeExit")
	local exitPart = if exit and exit:IsA("BasePart") then exit else nil
	if def.index == GameConfig.BiomeCount and exitPart then
		finishPart = exitPart
	end
	runtimes[def.index] = {
		def = def,
		folder = biomeFolder,
		path = path,
		checkpoints = checkpoints,
		checkpointS = checkpointS,
		eggPedestal = pedestalCFrame,
		exit = exitPart,
	}
end

function BiomeRegistry.Init() end

function BiomeRegistry.Start()
	local obby = obbyFolder()
	for _, def in ipairs(Biomes) do
		local name = string.format("Biome_%02d", def.index)
		local existing = obby:FindFirstChild(name)
		local folder: Folder
		if existing and existing:IsA("Folder") then
			folder = existing
		else
			assert(GameConfig.GenerateMissingBiomes, `{name} is missing and generation is disabled`)
			folder = StageBuilder.BuildBiome(def, obby)
		end
		register(def, folder)
	end
	StageBuilder.InstallKillBricks()
end

function BiomeRegistry.Get(index: number): BiomeRuntime
	local runtime = runtimes[index]
	assert(runtime, `biome {index} is not registered`)
	return runtime
end

function BiomeRegistry.All(): { [number]: BiomeRuntime }
	return runtimes
end

function BiomeRegistry.BiomeForStage(stage: number): number
	return math.clamp(math.ceil(stage / GameConfig.StagesPerBiome), 1, GameConfig.BiomeCount)
end

function BiomeRegistry.StageInBiome(stage: number): number
	if stage > GameConfig.TotalStages then
		return GameConfig.StagesPerBiome
	end
	return (stage - 1) % GameConfig.StagesPerBiome + 1
end

--- The part a player spawns on for a stage (the Finish part for stage 201).
function BiomeRegistry.CheckpointPart(stage: number): BasePart
	if stage > GameConfig.TotalStages and finishPart then
		return finishPart
	end
	local runtime = BiomeRegistry.Get(BiomeRegistry.BiomeForStage(stage))
	return runtime.checkpoints[BiomeRegistry.StageInBiome(stage)]
end

function BiomeRegistry.CheckpointS(stage: number): number
	local runtime = BiomeRegistry.Get(BiomeRegistry.BiomeForStage(stage))
	if stage > GameConfig.TotalStages then
		return runtime.path.length
	end
	return runtime.checkpointS[BiomeRegistry.StageInBiome(stage)]
end

function BiomeRegistry.FinishPart(): BasePart?
	return finishPart
end

function BiomeRegistry.ClientInfo(index: number): Types.ClientBiomeInfo
	local cached = clientInfoCache[index]
	if cached then
		return cached
	end
	local runtime = BiomeRegistry.Get(index)
	local info: Types.ClientBiomeInfo = {
		index = index,
		points = PathUtil.serialize(runtime.path),
		checkpointS = table.clone(runtime.checkpointS),
		length = runtime.path.length,
		eggPedestal = runtime.eggPedestal,
	}
	clientInfoCache[index] = info
	return info
end

return BiomeRegistry
